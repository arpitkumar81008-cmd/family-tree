rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: trees
// Document ID: {treeId} (auto-generated or custom tree identifier)
// Fields:
//   - title: string (required, 1..120 chars) - display title of the family tree
//   - ownerUid: string (required, 1..128 chars, immutable) - UID of the tree creator/owner
//   - ownerName: string (optional, 0..120 chars, owner-only mutable) - display name of the tree owner
//   - isPublic: bool (required, owner-only mutable) - whether anyone can view this tree without signing in
//   - collaboratorUids: list of strings (optional, max 50 items, owner-only mutable) - UIDs of authorized editors
//   - viewerUids: list of strings (optional, max 50 items, owner-only mutable) - UIDs of authorized read-only viewers
//   - viewerEmails: list of strings (optional, max 50 items, owner-only mutable) - legacy email addresses of invited viewers
//   - editorEmails: list of strings (optional, max 50 items, owner-only mutable) - legacy email addresses of invited editors
//   - shareCode: string (optional, 0..32 chars, owner-only mutable) - legacy Family Access Code
//   - shareCodeRole: string (optional, enum: ['viewer', 'editor', ''], owner-only mutable) - legacy share code role
//   - data: map (required, keys: ['people', 'couples']) - lineage graph containing people and couples lists (max 5000 entries each)
//   - photos: map (optional, max 500 entries) - map of personId -> photo URL or data URL
//   - lang: string (optional, enum: ['en', 'hi']) - default language preference for the tree
//   - createdAt: timestamp | number | string (optional, immutable on update) - creation timestamp
//   - updatedAt: timestamp | number | string (optional) - last modification timestamp
//
// Subcollection: trees/{treeId}/private
// Document ID: {docId} (e.g., 'sharing')
// Fields:
//   - viewerEmails: list of strings (optional, max 50 items) - email addresses of invited read-only family viewers
//   - editorEmails: list of strings (optional, max 50 items) - email addresses of invited family editors/collaborators
//   - shareCode: string (optional, 0..32 chars) - optional Family Access Code for server-side redemption
//   - shareCodeRole: string (optional, enum: ['viewer', 'editor', '']) - role granted by shareCode
//   - ownerNotificationEmail: string (optional, 0..160 chars) - optional email for owner join-request notifications
//   - updatedAt: timestamp | number | string (optional) - last modification timestamp
//
// Subcollection: trees/{treeId}/joinRequests
// Document ID: {requesterUid} (UID of the authenticated user requesting access)
// Fields:
//   - requesterUid: string (required, must match document ID, immutable) - UID of the requester
//   - requesterName: string (optional, 0..120 chars) - display name of the requester
//   - requesterEmail: string (optional, 0..160 chars) - email of the requester
//   - requestedRole: string (required, enum: ['viewer', 'editor']) - requested access role
//   - approvedRole: string (optional, nullable, enum: ['viewer', 'editor']) - role granted upon approval
//   - shareCode: string (optional, 0..32 chars) - Family Access Code submitted with the request
//   - note: string (optional, 0..300 chars) - optional message from the requester
//   - status: string (required, enum: ['pending', 'approved', 'rejected']) - request status
//   - createdAt: timestamp | number | string (optional) - creation timestamp
//   - updatedAt: timestamp | number | string (optional) - last modification timestamp
//
// Collection: admins
// Document ID: {uid} (UID of an authorized admin user, provisioned out-of-band)
// Fields:
//   - Any admin metadata (client writes are completely denied)
//
// Collection: analytics_daily
// Document ID: {dayId} (YYYY-MM-DD date string, 10 chars)
// Fields:
//   - date: string (required, must match dayId, 10 chars) - UTC/local day identifier
//   - pageViews: int (optional, 0..10000000) - daily page view counter
//   - treesCreated: int (optional, 0..10000000) - daily trees created counter
//   - photosUploaded: int (optional, 0..10000000) - daily photos uploaded counter
//   - relationsSolved: int (optional, 0..10000000) - daily relations solved counter
//   - joinRequests: int (optional, 0..10000000) - daily join requests counter
//   - updatedAt: timestamp | number | string (optional) - last modification timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is a provisioned admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if the authenticated user has a verified email in their auth token
    function hasAuthEmail() {
      return isAuthenticated() &&
        ('email_verified' in request.auth.token) &&
        (request.auth.token.email_verified == true) &&
        ('email' in request.auth.token) &&
        (request.auth.token.email is string);
    }

    // Check if the authenticated user's verified email is in editorEmails on the existing tree document
    function isEmailEditor() {
      return hasAuthEmail() &&
        ('editorEmails' in resource.data) &&
        (resource.data.editorEmails is list) &&
        (request.auth.token.email in resource.data.editorEmails ||
         request.auth.token.email.lower() in resource.data.editorEmails);
    }

    // Check if the authenticated user's verified email is in viewerEmails on the existing tree document
    function isEmailViewer() {
      return hasAuthEmail() &&
        ('viewerEmails' in resource.data) &&
        (resource.data.viewerEmails is list) &&
        (request.auth.token.email in resource.data.viewerEmails ||
         request.auth.token.email.lower() in resource.data.viewerEmails);
    }

    // Check if the authenticated user is the owner of the existing tree document
    function isTreeOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Check if the authenticated user is listed in collaboratorUids on the existing tree document
    function isUidCollaborator() {
      return isAuthenticated() &&
        ('collaboratorUids' in resource.data) &&
        (resource.data.collaboratorUids is list) &&
        (request.auth.uid in resource.data.collaboratorUids);
    }

    // Check if the authenticated user is listed in viewerUids on the existing tree document
    function isUidViewer() {
      return isAuthenticated() &&
        ('viewerUids' in resource.data) &&
        (resource.data.viewerUids is list) &&
        (request.auth.uid in resource.data.viewerUids);
    }

    // Check if the authenticated user is the owner of the parent tree document
    function isParentTreeOwner(treeId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid;
    }

    // Validate that all required fields exist on the incoming document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the incoming document contains only whitelisted fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string type and length bounds
    function validStringLength(field, minLen, maxLen) {
      return (field in request.resource.data) &&
        (request.resource.data[field] is string) &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string field (if present and non-null, must be string within bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate optional timestamp/date representation (timestamp, number, or ISO/date string <= 64 chars)
    function isValidOptionalTime(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is timestamp ||
        request.resource.data[field] is int ||
        request.resource.data[field] is float ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= 64);
    }

    // Validate that specified fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate nested tree data map ('people' and 'couples' lists)
    function isValidTreeDataMap(treeData) {
      return treeData is map &&
        treeData.keys().hasAll(['people', 'couples']) &&
        treeData.keys().hasOnly(['people', 'couples']) &&
        treeData.people is list &&
        treeData.people.size() <= 5000 &&
        treeData.couples is list &&
        treeData.couples.size() <= 5000;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidTreePayload(doc) {
      return hasRequiredFields(['title', 'ownerUid', 'isPublic', 'data']) &&
        hasOnlyAllowedFields([
          'title',
          'ownerUid',
          'ownerName',
          'isPublic',
          'collaboratorUids',
          'viewerUids',
          'viewerEmails',
          'editorEmails',
          'shareCode',
          'shareCodeRole',
          'data',
          'photos',
          'lang',
          'version',
          'createdAt',
          'updatedAt'
        ]) &&
        validStringLength('title', 1, 120) &&
        validStringLength('ownerUid', 1, 128) &&
        isValidOptionalString('ownerName', 0, 120) &&
        (doc.isPublic is bool) &&
        (!('collaboratorUids' in doc) ||
          (doc.collaboratorUids is list && doc.collaboratorUids.size() <= 50)) &&
        (!('viewerUids' in doc) ||
          (doc.viewerUids is list && doc.viewerUids.size() <= 50)) &&
        (!('viewerEmails' in doc) ||
          (doc.viewerEmails is list && doc.viewerEmails.size() <= 50)) &&
        (!('editorEmails' in doc) ||
          (doc.editorEmails is list && doc.editorEmails.size() <= 50)) &&
        isValidOptionalString('shareCode', 0, 32) &&
        (!('shareCodeRole' in doc) ||
          doc.shareCodeRole == null ||
          (doc.shareCodeRole is string && doc.shareCodeRole in ['viewer', 'editor', ''])) &&
        isValidTreeDataMap(doc.data) &&
        (!('photos' in doc) ||
          (doc.photos is map && doc.photos.size() <= 500)) &&
        (!('lang' in doc) ||
          (doc.lang is string && doc.lang in ['en', 'hi'])) &&
        (!('version' in doc) ||
          doc.version == null ||
          (doc.version is int && doc.version >= 0)) &&
        isValidOptionalTime('createdAt') &&
        isValidOptionalTime('updatedAt');
    }

    function isValidPrivateSharingPayload(doc) {
      return hasOnlyAllowedFields([
          'viewerEmails',
          'editorEmails',
          'shareCode',
          'shareCodeRole',
          'ownerNotificationEmail',
          'updatedAt'
        ]) &&
        (!('viewerEmails' in doc) ||
          (doc.viewerEmails is list && doc.viewerEmails.size() <= 50)) &&
        (!('editorEmails' in doc) ||
          (doc.editorEmails is list && doc.editorEmails.size() <= 50)) &&
        isValidOptionalString('shareCode', 0, 32) &&
        (!('shareCodeRole' in doc) ||
          doc.shareCodeRole == null ||
          (doc.shareCodeRole is string && doc.shareCodeRole in ['viewer', 'editor', ''])) &&
        isValidOptionalString('ownerNotificationEmail', 0, 160) &&
        isValidOptionalTime('updatedAt');
    }

    function isValidJoinRequestPayload(doc, requesterUid) {
      return hasRequiredFields(['requesterUid', 'requestedRole', 'status']) &&
        hasOnlyAllowedFields([
          'requesterUid',
          'requesterName',
          'requesterEmail',
          'requestedRole',
          'approvedRole',
          'shareCode',
          'note',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        (doc.requesterUid is string) &&
        doc.requesterUid == requesterUid &&
        (doc.requestedRole is string) &&
        doc.requestedRole in ['viewer', 'editor'] &&
        (!('approvedRole' in doc) ||
          doc.approvedRole == null ||
          (doc.approvedRole is string && doc.approvedRole in ['viewer', 'editor'])) &&
        (doc.status is string) &&
        doc.status in ['pending', 'approved', 'rejected'] &&
        isValidOptionalString('requesterName', 0, 120) &&
        isValidOptionalString('requesterEmail', 0, 160) &&
        isValidOptionalString('shareCode', 0, 32) &&
        isValidOptionalString('note', 0, 300) &&
        isValidOptionalTime('createdAt') &&
        isValidOptionalTime('updatedAt');
    }

    // Validate optional non-negative integer counter bounded to 10,000,000
    function isValidOptionalCounter(doc, field) {
      return !(field in doc) ||
        (doc[field] is int && doc[field] >= 0 && doc[field] <= 10000000);
    }

    // Validate optional counter on create (if present, must be 0 or 1)
    function isValidAnalyticsCreateCounter(doc, field) {
      return !(field in doc) ||
        (doc[field] is int && (doc[field] == 0 || doc[field] == 1));
    }

    function isValidAnalyticsDailyCreateCounters(doc) {
      return isValidAnalyticsCreateCounter(doc, 'pageViews') &&
        isValidAnalyticsCreateCounter(doc, 'treesCreated') &&
        isValidAnalyticsCreateCounter(doc, 'photosUploaded') &&
        isValidAnalyticsCreateCounter(doc, 'relationsSolved') &&
        isValidAnalyticsCreateCounter(doc, 'joinRequests');
    }

    // Validate monotonic single-step increment (+0 or +1) for analytics counters on update
    function isValidAnalyticsCounterIncrement(field) {
      return resource.data.get(field, 0) is int &&
        request.resource.data.get(field, 0) is int &&
        request.resource.data.get(field, 0) >= resource.data.get(field, 0) &&
        request.resource.data.get(field, 0) <= resource.data.get(field, 0) + 1;
    }

    function isValidAnalyticsDailyUpdateCounters() {
      return isValidAnalyticsCounterIncrement('pageViews') &&
        isValidAnalyticsCounterIncrement('treesCreated') &&
        isValidAnalyticsCounterIncrement('photosUploaded') &&
        isValidAnalyticsCounterIncrement('relationsSolved') &&
        isValidAnalyticsCounterIncrement('joinRequests');
    }

    function isValidAnalyticsDailyPayload(doc, dayId) {
      return hasRequiredFields(['date']) &&
        hasOnlyAllowedFields([
          'date',
          'pageViews',
          'treesCreated',
          'photosUploaded',
          'relationsSolved',
          'joinRequests',
          'updatedAt'
        ]) &&
        dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (doc.date is string) &&
        doc.date == dayId &&
        doc.date.size() == 10 &&
        isValidOptionalCounter(doc, 'pageViews') &&
        isValidOptionalCounter(doc, 'treesCreated') &&
        isValidOptionalCounter(doc, 'photosUploaded') &&
        isValidOptionalCounter(doc, 'relationsSolved') &&
        isValidOptionalCounter(doc, 'joinRequests') &&
        isValidOptionalTime('updatedAt');
    }

    // ===============================================================
    // Collection Rules: /trees/{treeId}
    // ===============================================================

    match /trees/{treeId} {
      // Read (get, list):
      // Allowed ONLY if public, owner, UID collaborator, UID viewer, or verified invited email.
      // Share codes never grant direct Firestore read access.
      allow get, list: if resource.data.isPublic == true ||
        isTreeOwner() ||
        isUidCollaborator() ||
        isUidViewer() ||
        isEmailEditor() ||
        isEmailViewer();

      // Create:
      // Allowed only for authenticated users setting themselves as ownerUid with valid schema.
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidTreePayload(request.resource.data);

      // Update:
      // Allowed ONLY for the owner or a UID-listed collaborator.
      // - Schema must remain valid (prevents Update Bypass).
      // - ownerUid and existing createdAt are always immutable.
      // - Collaborators cannot modify ownership, visibility, UIDs, sharing fields, or createdAt.
      allow update: if isValidTreePayload(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (!('createdAt' in resource.data) ||
          ('createdAt' in request.resource.data &&
           request.resource.data.createdAt == resource.data.createdAt)) &&
        (
          isTreeOwner() ||
          (isUidCollaborator() &&
           areImmutableFieldsUnchanged([
             'ownerUid',
             'ownerName',
             'isPublic',
             'collaboratorUids',
             'viewerUids',
             'viewerEmails',
             'editorEmails',
             'shareCode',
             'shareCodeRole',
             'createdAt'
           ]))
        );

      // Delete:
      // Allowed strictly for the tree owner.
      allow delete: if isTreeOwner();

      // ===============================================================
      // Subcollection Rules: /trees/{treeId}/private/{docId}
      // ===============================================================
      // Holds sensitive sharing configuration (viewerEmails, editorEmails,
      // shareCode, shareCodeRole, ownerNotificationEmail) readable and
      // writable ONLY by the parent tree's ownerUid.
      match /private/{docId} {
        allow get, list: if isParentTreeOwner(treeId);
        allow create, update: if isParentTreeOwner(treeId) &&
          isValidPrivateSharingPayload(request.resource.data);
        allow delete: if isParentTreeOwner(treeId);
      }

      // ===============================================================
      // Subcollection Rules: /trees/{treeId}/joinRequests/{requesterUid}
      // ===============================================================
      // Spark-plan-compatible Join Request & Owner Approval workflow.
      // Requesters can read/create/resubmit/delete their own pending request;
      // the parent tree owner can list, read, approve/reject, and delete requests.
      match /joinRequests/{requesterUid} {
        allow get: if isAuthenticated() &&
          (request.auth.uid == requesterUid || isParentTreeOwner(treeId));

        allow list: if isParentTreeOwner(treeId);

        allow create: if isAuthenticated() &&
          request.auth.uid == requesterUid &&
          isValidJoinRequestPayload(request.resource.data, requesterUid) &&
          request.resource.data.status == 'pending' &&
          (!('approvedRole' in request.resource.data) ||
           request.resource.data.approvedRole == null);

        allow update: if isValidJoinRequestPayload(request.resource.data, requesterUid) &&
          request.resource.data.requesterUid == resource.data.requesterUid &&
          (
            (isParentTreeOwner(treeId) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedRole', 'updatedAt'])) ||
            (isAuthenticated() &&
             request.auth.uid == requesterUid &&
             request.resource.data.status == 'pending' &&
             request.resource.data.requesterUid == requesterUid &&
             (!('approvedRole' in request.resource.data) ||
              request.resource.data.approvedRole == null))
          );

        allow delete: if isAuthenticated() &&
          (request.auth.uid == requesterUid || isParentTreeOwner(treeId));
      }
    }

    // ===============================================================
    // Collection Rules: /admins/{uid}
    // ===============================================================

    match /admins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ===============================================================
    // Collection Rules: /analytics_daily/{dayId}
    // ===============================================================

    match /analytics_daily/{dayId} {
      allow get, list: if isAdmin();
      allow create: if isValidAnalyticsDailyPayload(request.resource.data, dayId) &&
        isValidAnalyticsDailyCreateCounters(request.resource.data);
      allow update: if isValidAnalyticsDailyPayload(request.resource.data, dayId) &&
        request.resource.data.date == resource.data.date &&
        isValidAnalyticsDailyUpdateCounters();
      allow delete: if false;
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
